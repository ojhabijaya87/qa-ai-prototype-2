{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": false,
    "types": ["node"]
  },
  "include": [
    "pages/**/*.ts",
    "fixtures/**/*.ts",
    "utils/**/*.ts",
    "test-data/**/*.ts",
    "types/**/*.ts",
    "tests/**/*.ts",
    "config/**/*.ts"
, "tests/.temp_gen/NL-001.spec.ts"  ]
}
